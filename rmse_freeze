#!/usr/bin/env python3
"""
Plot Freezing Level RMSE of multiple WRF runs vs WRFDA reference (wrfvar.csv).

Reads (from same directory as this script):
  fulldata.csv, noinsitu.csv, nosat.csv, noda.csv, wrfvar.csv

Assumes:
  - wide CSV
  - time column named 'time'
  - freezing level columns end with '_frz_msl_m' (default) or '_frz_agl_m' (optional)

Handles time mismatch:
  - WRF runs are hourly
  - WRFDA is 6-hourly
  - WRFDA series is resampled to hourly and interpolated in time before RMSE is computed

Outputs:
  rmse_freezing_level_vs_wrfvar.png
"""

from __future__ import annotations

from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


SCRIPT_DIR = Path(__file__).resolve().parent

FILES = {
    "Full Data": "fulldata.csv",
    "No In-situ": "noinsitu.csv",
    "No Sat": "nosat.csv",
    "No DA": "noda.csv",
}
WRFVAR_FILE = "wrfvar.csv"

# Choose which freezing level definition to use:
#   "_frz_msl_m" for MSL freezing level
#   "_frz_agl_m" for AGL freezing level
FREEZE_SUFFIX = "_frz_msl_m"


def parse_wrf_time(series: pd.Series) -> pd.Series:
    s = series.astype(str).str.strip()

    t = pd.to_datetime(s, format="%Y-%m-%d_%H:%M:%S", errors="coerce")

    mask = t.isna()
    if mask.any():
        t2 = pd.to_datetime(s[mask], format="%Y-%m-%d %H:%M:%S", errors="coerce")
        t.loc[mask] = t2

    mask = t.isna()
    if mask.any():
        t3 = pd.to_datetime(s[mask].str.replace("_", " ", regex=False), errors="coerce")
        t.loc[mask] = t3

    if t.isna().any():
        bad = s[t.isna()].iloc[:5].tolist()
        raise ValueError(
            "Failed to parse some timestamps in 'time'. Examples:\n  "
            + "\n  ".join(bad)
        )

    return t


def load_csv(fname: str) -> pd.DataFrame:
    path = SCRIPT_DIR / fname
    if not path.exists():
        raise FileNotFoundError(f"Missing file: {path}")

    df = pd.read_csv(path)

    if "time" not in df.columns:
        raise KeyError(f"{fname} has no 'time' column")

    df["time"] = parse_wrf_time(df["time"])
    df = df.sort_values("time").set_index("time")
    return df


def freeze_cols(df: pd.DataFrame, suffix: str) -> list[str]:
    return [c for c in df.columns if c.endswith(suffix)]


def compute_rmse_series(model: pd.DataFrame, ref: pd.DataFrame, cols: list[str]) -> pd.Series:
    diff2 = (model[cols] - ref[cols]) ** 2
    return np.sqrt(diff2.mean(axis=1))


def main() -> None:
    # Load reference (6-hourly)
    wrfvar = load_csv(WRFVAR_FILE)

    ref_cols = freeze_cols(wrfvar, FREEZE_SUFFIX)
    if not ref_cols:
        raise RuntimeError(
            f"No freezing level columns found in {WRFVAR_FILE} with suffix {FREEZE_SUFFIX!r}.\n"
            f"Available columns example: {wrfvar.columns[:10].tolist()}"
        )

    # Interpolate WRFDA to hourly
    wrfvar_hourly = wrfvar[ref_cols].resample("1h").interpolate("time")

    rmse_series = {}

    for label, fname in FILES.items():
        df = load_csv(fname)

        model_cols = freeze_cols(df, FREEZE_SUFFIX)
        if not model_cols:
            raise RuntimeError(f"No freezing level columns found in {fname} with suffix {FREEZE_SUFFIX!r}")

        cols = sorted(set(model_cols).intersection(ref_cols))
        if not cols:
            raise RuntimeError(
                f"No common freezing level columns between {fname} and {WRFVAR_FILE} for suffix {FREEZE_SUFFIX!r}.\n"
                f"{fname} example cols: {model_cols[:5]}\n"
                f"{WRFVAR_FILE} example cols: {ref_cols[:5]}"
            )

        common_idx = df.index.intersection(wrfvar_hourly.index)
        if common_idx.empty:
            raise RuntimeError(f"No overlapping times between {fname} and interpolated {WRFVAR_FILE}")

        model_aligned = df.loc[common_idx, cols]
        ref_aligned = wrfvar_hourly.loc[common_idx, cols]

        rmse_series[label] = compute_rmse_series(model_aligned, ref_aligned, cols)

    # Plot
    plt.figure(figsize=(12, 6))
    for label, s in rmse_series.items():
        plt.plot(s.index, s.values, label=label)

    #plt.title(f"Freezing Level RMSE vs WRFDA (wrfvar.csv) [{FREEZE_SUFFIX}]")
    plt.xlabel("Time")
    plt.ylabel("RMSE (m)")
    plt.grid(True)
    plt.legend()

    outpath = SCRIPT_DIR / "rmse_freezing_level_vs_wrfvar.png"
    plt.savefig(outpath, dpi=150, bbox_inches="tight")
    print(f"Saved: {outpath}")


if __name__ == "__main__":
    main()

